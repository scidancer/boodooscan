              <td class="py-2 px-2 text-right font-mono font-semibold ${item.deltaA >= state.cutoffDeltaA && !isWhite && item.role !== 'control' ? 'text-teal-700' : 'text-slate-600'}">${isWhite ? '—' : (item.deltaA >= 0 ? '+' : '') + item.deltaA.toFixed(1)}</td>
              <td class="py-2 px-2 text-right font-mono text-slate-600">${isWhite ? '—' : item.deltaE.toFixed(1)}</td>
