        const noteCell = isWhite
          ? `<td class="py-2 px-2 text-slate-300 text-[11px]">—</td>`
          : `<td class="py-2 px-2">
              <input type="text" value="${escapeHtml(item.note || '')}" oninput="updateRoiNote(${item.id}, this.value)"
                placeholder="e.g., Milk, Rep 1"
                class="w-24 sm:w-32 px-2 py-1 text-[11px] text-slate-700 bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 focus:border-teal-500 rounded focus:outline-none" />
