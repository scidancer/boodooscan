            ${showNTCol ? `<td class="py-2 px-2 text-right font-mono font-semibold text-amber-800">${item.ratioVsMaxNT != null ? item.ratioVsMaxNT.toFixed(2) + '×' : '—'}</td>` : ''}
            <td class="py-2 px-3 text-center">
              <span class="inline-block text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full ${getCallBadgeClass(item.call)}">${item.call}</span>
