<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>BoodooScan Auto — GNP Colorimetric Biosensor Analyzer</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'system-ui', 'sans-serif'],
            mono: ['JetBrains Mono', 'ui-monospace', 'monospace'],
          },
          colors: {
            navy: { 900: '#0F172A', 800: '#1E293B' },
            teal: { 600: '#0D9488', 700: '#0F766E' }
          }
        }
      }
    };

    window.triggerPhotoPicker = function triggerPhotoPicker(inputId) {
      const el = document.getElementById(inputId);
      if (!el) return;
      try {
        if (typeof el.showPicker === 'function') {
          el.showPicker();
          return;
        }
      } catch (_) {}
      el.click();
    };
  </script>
  <style>
    body {
      font-family: 'Inter', system-ui, sans-serif;
      background-color: #F8FAFC;
      color: #0F172A;
    }
    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #F1F5F9; border-radius: 4px; }
    ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
    #imageCanvas { touch-action: none; }
    .th-tip {
      cursor: help;
      text-decoration: underline dotted #94A3B8;
      text-underline-offset: 3px;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col">

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- ===================================================================== -->
  <!-- TABBED USER GUIDE MODAL                                               -->
  <!-- ===================================================================== -->
  <div id="guideModal" class="hidden fixed inset-0 z-50 bg-slate-900/70 backdrop-blur-xs flex items-center justify-center p-4" onclick="closeGuideOnBackdrop(event)">
    <div class="bg-white rounded-2xl shadow-2xl border border-slate-200 max-w-2xl w-full max-h-[88vh] flex flex-col overflow-hidden" onclick="event.stopPropagation()">
      <!-- Modal Header -->
      <div class="px-5 py-4 bg-navy-900 text-white flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="w-7 h-7 rounded-lg bg-teal-600/30 border border-teal-400/40 text-teal-300 flex items-center justify-center font-bold text-sm">?</span>
          <div>
            <h2 class="text-base font-bold leading-tight">BoodooScan Auto Guide</h2>
            <p class="text-[11px] text-slate-400">Quick workflow, per-tube notes, Research Mode, and photo tips</p>
          </div>
        </div>
        <button type="button" onclick="closeGuideModal()" class="text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition text-lg leading-none" aria-label="Close guide">×</button>
      </div>

      <!-- Modal Tabs -->
      <div class="px-5 pt-3 bg-slate-50 border-b border-slate-200 flex gap-2">
        <button type="button" id="tabBtnHow" onclick="switchGuideTab('how')" class="px-3.5 py-2 text-xs font-semibold rounded-t-lg border-b-2 border-teal-600 text-teal-700 bg-white">How to Use</button>
        <button type="button" id="tabBtnMetrics" onclick="switchGuideTab('metrics')" class="px-3.5 py-2 text-xs font-semibold rounded-t-lg border-b-2 border-transparent text-slate-500 hover:text-slate-800">Metrics &amp; Research Mode</button>
        <button type="button" id="tabBtnTips" onclick="switchGuideTab('tips')" class="px-3.5 py-2 text-xs font-semibold rounded-t-lg border-b-2 border-transparent text-slate-500 hover:text-slate-800">Photo Tips</button>
      </div>

      <!-- Modal Body -->
      <div class="p-5 overflow-y-auto text-xs text-slate-700 space-y-4 leading-relaxed">
        <!-- TAB 1: HOW TO USE -->
        <div id="guideTabHow" class="space-y-3.5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="inline-block text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded bg-teal-100 text-teal-800 mb-1.5">Step 1</span>
              <h3 class="font-bold text-navy-900 mb-1">Take, Upload, or Paste a Photo</h3>
              <p class="text-slate-600">Tap <strong>Take Photo</strong> on Android/iPhone to open your rear camera, click <strong>Upload Photo</strong>, drag &amp; drop a file, or press <strong>Ctrl+V / Cmd+V</strong> anywhere on the page to paste a copied image.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="inline-block text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded bg-cyan-100 text-cyan-800 mb-1.5">Step 2</span>
              <h3 class="font-bold text-navy-900 mb-1">Frame Only the Liquid Tips</h3>
              <p class="text-slate-600">Keep the cyan <strong>Scan Box</strong> tightly around the conical liquid tips (below the plastic caps/rack lip and above the yellow tape). Auto-detection locks onto the colored liquid core at the bottom of each tube.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="inline-block text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded bg-violet-100 text-violet-800 mb-1.5">Step 3</span>
              <h3 class="font-bold text-navy-900 mb-1">Tag Roles &amp; Per-Tube Notes</h3>
              <p class="text-slate-600">The leftmost tube defaults to <strong>Water Control (C)</strong>. Set any tube to <strong>Non-Target (NT)</strong> or <strong>Sample (S)</strong>, rename labels inline, or type sample/replicate details in each tube's <strong>Tube Note</strong> box.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
              <span class="inline-block text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 mb-1.5">Step 4</span>
              <h3 class="font-bold text-navy-900 mb-1">Check QC, Save &amp; Export</h3>
              <p class="text-slate-600">Verify the <strong>Water-Control QC Gate</strong> shows <strong>PASS</strong>, click <strong>Save Run</strong> (auto-saved in your browser), and click <strong>Export CSV</strong> when finished with your batch.</p>
            </div>
          </div>

          <div class="p-3.5 rounded-xl bg-sky-50 border border-sky-200 text-sky-950 text-[11px] space-y-1">
            <p class="font-bold text-sky-900">Quick Shortcuts (Android &amp; Computer):</p>
            <p>• <strong>On Android / iPhone:</strong> Tap <strong>Upload Photo</strong>, open the top-left menu / <strong>Browse</strong> in your phone's picker, and pick from <strong>Google Photos</strong> or Gallery.</p>
            <p>• <strong>On Laptop / Desktop:</strong> Right-click any photo in your browser or folder → <strong>Copy image</strong>, then click anywhere on BoodooScan and press <strong>Ctrl+V</strong> (or <strong>Cmd+V</strong> on Mac).</p>
          </div>
        </div>

        <!-- TAB 2: METRICS & RESEARCH MODE -->
        <div id="guideTabMetrics" class="hidden space-y-3">
          <p class="text-slate-600">By default, everyday users see only <strong>Tube</strong>, <strong>Tube Note</strong>, <strong>Role</strong>, <strong>Signal</strong>, and <strong>Result</strong> (<strong>POSITIVE</strong> or <strong>NEGATIVE</strong>). Toggle <strong>Research Mode</strong> on to inspect every colorimetric metric below (all 22 columns are always included in the exported CSV).</p>
          <div class="divide-y divide-slate-200 border border-slate-200 rounded-xl overflow-hidden">
            <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
              <span class="font-mono font-bold text-navy-900 sm:w-28 shrink-0">Signal (Rel A_G/A_R)</span>
              <p class="text-slate-600">Beer–Lambert pseudo-absorbance ratio (green channel optical density divided by red channel optical density), normalized to the Water Control (= 1.00). Mirrors a spectrophotometer's A520/A620 ratio; positive red tubes are typically ≥ 1.30.</p>
            </div>
            <div class="p-3 bg-slate-50/60 flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
              <span class="font-mono font-bold text-navy-900 sm:w-28 shrink-0">a* (CIE Redness)</span>
              <p class="text-slate-600">Green-to-red color axis in CIE L*a*b* space, separated from brightness. Combined with the blue-yellow axis (b*) and R/B ratio for the <strong>QC Gate</strong>: purple/violet/gray controls pass, while unaggregated red/pink controls (a* &gt; 24, b* &gt; -6, R/B &gt; 1.20) are flagged INVALID.</p>
            </div>
            <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
              <span class="font-mono font-bold text-teal-700 sm:w-28 shrink-0">Δa*</span>
              <p class="text-slate-600">Redness shift compared to the Water Control (a*<sub>sample</sub> − a*<sub>water</sub>). Near 0 means it matches the negative control; ≥ 10.0 indicates target DNA kept the GNPs red.</p>
            </div>
            <div class="p-3 bg-slate-50/60 flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
              <span class="font-mono font-bold text-navy-900 sm:w-28 shrink-0">ΔE</span>
              <p class="text-slate-600">Total 3D Euclidean color distance from the Water Control across L*, a*, and b*. Values &lt; 3 look nearly identical to the human eye; values &gt; 10 are clearly distinct.</p>
            </div>
            <div class="p-3 bg-white flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
              <span class="font-mono font-bold text-navy-900 sm:w-28 shrink-0">Legacy R/B</span>
              <p class="text-slate-600">Simple linear raw Red/Blue ratio normalized to the Water Control, included so you can benchmark the new CIE L*a*b* and Beer–Lambert metrics against the original app formula.</p>
            </div>
            <div class="p-3 bg-slate-50/60 flex flex-col sm:flex-row sm:items-start gap-1 sm:gap-4">
              <span class="font-mono font-bold text-amber-800 sm:w-28 shrink-0">Sig / Max NT</span>
              <p class="text-slate-600">Sample Signal divided by the highest Non-Target (NT) tube in the same photo. Automatically activates when any tube is tagged <strong>Non-Target (NT)</strong>.</p>
            </div>
          </div>
        </div>

        <!-- TAB 3: PHOTO TIPS -->
        <div id="guideTabTips" class="hidden space-y-3">
          <ul class="space-y-2.5 text-slate-600">
            <li class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-teal-100 text-teal-700 font-bold flex items-center justify-center shrink-0 mt-0.5">1</span>
              <span><strong>Keep the Scan Box below the upper plastic lip:</strong> Frame just the liquid tips and the white rack background around them so shadows on the upper tube barrels don't pull the circle upward.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-teal-100 text-teal-700 font-bold flex items-center justify-center shrink-0 mt-0.5">2</span>
              <span><strong>Always include the Water Control (C) in the same photo:</strong> Keeping the negative control and samples in one horizontal row under identical lighting eliminates camera auto-exposure drift.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-teal-100 text-teal-700 font-bold flex items-center justify-center shrink-0 mt-0.5">3</span>
              <span><strong>Avoid direct flash or harsh overhead glare:</strong> Diffused room lighting produces the cleanest, most repeatable measurements.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-5 h-5 rounded-full bg-teal-100 text-teal-700 font-bold flex items-center justify-center shrink-0 mt-0.5">4</span>
              <span><strong>Keep tape below the liquid tips:</strong> Place colored labeling tape below the conical tube tips so the cyan Scan Box can frame the liquid without overlapping the tape.</span>
            </li>
          </ul>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="px-5 py-3 bg-slate-50 border-t border-slate-200 flex justify-end">
        <button type="button" onclick="closeGuideModal()" class="px-4 py-1.5 rounded-lg bg-navy-900 hover:bg-slate-800 text-white text-xs font-semibold transition">Got it</button>
      </div>
    </div>
  </div>

  <!-- Top Header Bar -->
  <header class="bg-navy-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-sm">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-teal-600/20 border border-teal-500/40 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="6" width="18" height="12" rx="2" stroke-dasharray="3 2" />
            <circle cx="8" cy="12" r="2.2" fill="#8B5CF6" stroke="none" />
            <circle cx="16" cy="12" r="2.2" fill="#F43F5E" stroke="none" />
          </svg>
        </div>
        <div>
          <h1 class="text-lg sm:text-xl font-bold tracking-tight leading-tight flex items-center gap-2">
            BoodooScan Auto
          </h1>
          <p class="text-xs text-slate-400">GNP Colorimetric Biosensor Analyzer • Auto-Detection &amp; QC Gate</p>
        </div>
      </div>

      <!-- Top Actions -->
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" onclick="openGuideModal('how')"
          class="text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-teal-300 border border-slate-700 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5">
          <span class="font-mono font-bold">?</span>
          <span>Guide</span>
        </button>

        <label for="cameraInput" class="cursor-pointer text-xs sm:text-sm font-semibold bg-teal-600 hover:bg-teal-500 text-white px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>Take Photo</span>
        </label>
        <input id="cameraInput" type="file" accept="image/*" capture="environment" class="hidden" />

        <label for="fileInput" class="cursor-pointer text-xs sm:text-sm font-semibold bg-white text-navy-900 hover:bg-slate-100 px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 12V3m0 0l-4 4m4-4l4 4" />
          </svg>
          <span>Upload Photo</span>
        </label>
        <input id="fileInput" type="file" accept="image/*" class="hidden" />

        <button id="headerSaveBtn" onclick="saveCurrentPhotoToSession()" disabled
          class="text-xs sm:text-sm font-medium bg-slate-700 hover:bg-slate-600 disabled:bg-slate-800 disabled:text-slate-500 disabled:cursor-not-allowed text-white px-3 py-1.5 rounded-lg transition flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Save Run</span>
        </button>

        <button id="headerExportBtn" onclick="exportSessionCSV()" disabled
          class="text-xs sm:text-sm font-semibold bg-teal-600 hover:bg-teal-500 disabled:bg-slate-800 disabled:text-slate-500 disabled:cursor-not-allowed text-white px-3.5 py-1.5 rounded-lg transition flex items-center gap-1.5 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5m0 0l5-5m-5 5V3" />
          </svg>
          <span>Export CSV (<span id="headerSessionCount" class="font-mono">0</span>)</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Main Workspace: Responsive Two-Column Layout -->
  <main class="flex-1 max-w-[1440px] w-full mx-auto px-4 sm:px-6 py-5">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-5 items-start">

      <!-- =================================================================== -->
      <!-- LEFT COLUMN (5 cols on xl): Interactive Canvas, Scan Box & Notes    -->
      <!-- =================================================================== -->
      <div class="xl:col-span-5 space-y-4">

        <!-- Interactive Canvas & Scan Box Card (Primary Dropzone) -->
        <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
          <!-- Toolbar -->
          <div class="px-4 py-2.5 bg-slate-50 border-b border-slate-200 flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-wrap items-center gap-1.5">
              <button type="button" id="redetectBtn" onclick="runAutoDetection()" disabled
                class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-teal-600 hover:bg-teal-500 disabled:bg-slate-200 disabled:text-slate-400 text-white transition flex items-center gap-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
                <span>Re-Detect</span>
              </button>

              <button type="button" id="manualAddBtn" onclick="toggleManualAddMode()" disabled
                class="px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 disabled:opacity-40 transition">
                + Manual Tube
              </button>

              <button type="button" id="resetBoxBtn" onclick="resetScanBox()" disabled
                class="px-2.5 py-1.5 rounded-lg text-xs font-medium border border-slate-300 bg-white text-slate-600 hover:bg-slate-100 disabled:opacity-40 transition">
                Reset Box
              </button>

              <button type="button" id="clearPhotoBtn" onclick="clearCurrentPhoto()" disabled
                class="px-2.5 py-1.5 rounded-lg text-xs font-medium border border-slate-300 bg-white text-rose-600 hover:bg-rose-50 hover:border-rose-200 disabled:opacity-40 disabled:text-slate-400 disabled:hover:bg-white disabled:hover:border-slate-300 transition">
                Clear Photo
              </button>
            </div>

            <div class="flex items-center gap-2 text-[11px] font-mono text-slate-500">
              <span id="currentFileName" class="truncate max-w-[130px]" title="Active filename">No file</span>
              <span id="detectionSummaryBadge" class="px-2 py-0.5 rounded-full bg-slate-200/80 text-slate-700 font-semibold">0 tubes</span>
            </div>
          </div>

          <!-- Canvas Dropzone Viewport -->
          <div id="canvasWrapper" class="relative bg-navy-900 min-h-[340px] sm:min-h-[390px] flex items-center justify-center overflow-hidden select-none">
            <!-- Empty Drop/Upload Prompt -->
            <div id="emptyCanvasPrompt" class="text-center p-6 max-w-sm">
              <button type="button" onclick="window.triggerPhotoPicker('fileInput')"
                class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-teal-400 flex items-center justify-center transition shadow-md cursor-pointer">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </button>
              <h2 class="text-sm font-bold text-white mb-1">Drop, Paste, or Choose a Tube Photo</h2>
              <p class="text-xs text-slate-400 leading-relaxed mb-4">
                Drag a rack photo here, press <span class="font-mono text-teal-300">Ctrl+V / Cmd+V</span> to paste, or choose a file below.
              </p>
              <div class="flex flex-wrap items-center justify-center gap-2">
                <button type="button" onclick="window.triggerPhotoPicker('cameraInput')"
                  class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-teal-600 hover:bg-teal-500 text-white transition shadow-sm cursor-pointer">
                  Take Photo
                </button>
                <button type="button" onclick="window.triggerPhotoPicker('fileInput')"
                  class="px-3.5 py-2 rounded-lg text-xs font-semibold bg-white hover:bg-slate-100 text-navy-900 transition shadow-sm cursor-pointer">
                  Choose Photo File
                </button>
              </div>
            </div>

            <!-- Interactive Image Canvas -->
            <canvas id="imageCanvas" class="hidden max-w-full max-h-[520px] w-auto h-auto block"></canvas>

            <!-- Drag-Over Highlight Overlay -->
            <div id="canvasDragOverlay" class="hidden absolute inset-0 bg-teal-900/80 border-2 border-dashed border-teal-300 flex flex-col items-center justify-center pointer-events-none z-20">
              <svg class="w-10 h-10 text-teal-300 mb-2" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 12V3m0 0l-4 4m4-4l4 4" />
              </svg>
              <p class="text-sm font-bold text-white">Drop Photo to Analyze</p>
            </div>
          </div>

          <!-- Ring Color Legend & Scan Box Coordinates -->
          <div class="px-4 py-2 bg-slate-50 border-t border-slate-200 flex flex-wrap items-center justify-between gap-2 text-[11px] text-slate-600">
            <div class="flex flex-wrap items-center gap-3">
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-violet-500 inline-block"></span>Water (C)</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-amber-500 inline-block"></span>Non-Target</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500 inline-block"></span>Positive</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full bg-slate-500 inline-block"></span>Negative</span>
              <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full border border-dashed border-slate-400 bg-white inline-block"></span>White Ref (W)</span>
            </div>
