              <option value="nontarget" ${item.role === 'nontarget' ? 'selected' : ''}>Non-Target (NT)</option>
              <option value="sample" ${item.role === 'sample' ? 'selected' : ''}>Sample (S)</option>
            </select>`;

        const tubeCell = `
          <td class="py-2 px-3">
            <div class="flex items-center gap-2">
              <span class="w-3.5 h-3.5 rounded-full border border-slate-300 shrink-0 shadow-xs" style="background:${swatch}"></span>
              <input type="text" value="${escapeHtml(item.label)}" onchange="renameRoi(${item.id}, this.value)"
                class="w-20 sm:w-24 px-1.5 py-0.5 text-xs font-semibold text-navy-900 bg-transparent hover:bg-slate-100 focus:bg-white border border-transparent focus:border-teal-500 rounded focus:outline-none" />
