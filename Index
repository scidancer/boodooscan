    // =========================================================================
    // ROI MUTATIONS & MANUAL ADD MODE
    // =========================================================================
    function renameRoi(id, newLabel) {
      const roi = state.rois.find(r => r.id === id);
      if (roi && newLabel.trim()) {
        roi.label = newLabel.trim();
        recalculateAndRender();
      }
    }

    function updateRoiNote(id, newNote) {
      const roi = state.rois.find(r => r.id === id);
      if (roi) {
        roi.note = newNote;
        const comp = state.computed.find(c => c.id === id);
        if (comp) comp.note = newNote;
      }
    }

    function changeRoiRole(id, newRole) {
      const target = state.rois.find(r => r.id === id);
      if (!target) return;

      if (newRole === 'control') {
        state.rois.forEach(r => {
          if (r.id !== id && r.role === 'control') {
            r.role = 'sample';
            if (r.label === 'Water (C)') r.label = `S${r.id}`;
          }
        });
        if (target.label.startsWith('S')) target.label = 'Water (C)';
      }
      target.role = newRole;
      recalculateAndRender();
    }

    function deleteRoi(id) {
      state.rois = state.rois.filter(r => r.id !== id);
      recalculateAndRender();
    }

    function toggleManualAddMode() {
      if (!state.image) return;
      state.manualAddMode = !state.manualAddMode;
      const btn = document.getElementById('manualAddBtn');
      if (state.manualAddMode) {
        btn.className = 'px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-teal-600 bg-teal-600 text-white transition shadow-sm';
        btn.textContent = 'Click Tube on Photo...';
        imageCanvas.style.cursor = 'crosshair';
      } else {
        btn.className = 'px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 transition';
        btn.textContent = '+ Manual Tube';
        imageCanvas.style.cursor = 'default';
      }
    }

    // =========================================================================
    // CANVAS RENDERING & 4-SIDED SCAN BOX + ROI POINTER INTERACTIONS
    // =========================================================================
    function drawCanvas() {
      if (!state.image) return;
      const W = state.image.naturalWidth;
      const H = state.image.naturalHeight;
      imageCanvas.width = W;
      imageCanvas.height = H;

      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(state.image, 0, 0, W, H);

      const bx = state.boxLeft * W;
      const by = state.boxTop * H;
      const bw = (state.boxRight - state.boxLeft) * W;
      const bh = (state.boxBottom - state.boxTop) * H;

      // Dim outside the 4-sided Scan Box
      ctx.save();
      ctx.fillStyle = 'rgba(15, 23, 42, 0.42)';
      ctx.fillRect(0, 0, W, by);
      ctx.fillRect(0, by + bh, W, H - (by + bh));
      ctx.fillRect(0, by, bx, bh);
      ctx.fillRect(bx + bw, by, W - (bx + bw), bh);
      ctx.restore();

      // Draw Scan Box border
      const lw = Math.max(2, Math.round(W * 0.003));
      ctx.save();
      ctx.strokeStyle = '#22D3EE';
      ctx.lineWidth = lw;
      ctx.setLineDash([lw * 3, lw * 2]);
      ctx.strokeRect(bx, by, bw, bh);
      ctx.setLineDash([]);

      // Draw edge grab pills on all 4 sides
      const pillLen = Math.max(18, Math.round(W * 0.04));
      const pillThick = Math.max(5, Math.round(W * 0.008));
      ctx.fillStyle = '#22D3EE';
      ctx.beginPath();
      ctx.roundRect(bx + bw / 2 - pillLen / 2, by - pillThick / 2, pillLen, pillThick, pillThick / 2);
      ctx.roundRect(bx + bw / 2 - pillLen / 2, by + bh - pillThick / 2, pillLen, pillThick, pillThick / 2);
      ctx.roundRect(bx - pillThick / 2, by + bh / 2 - pillLen / 2, pillThick, pillLen, pillThick / 2);
      ctx.roundRect(bx + bw - pillThick / 2, by + bh / 2 - pillLen / 2, pillThick, pillLen, pillThick / 2);
      ctx.fill();

      // Scan Box tag
      const tagFontSize = Math.max(10, Math.round(W * 0.015));
      ctx.font = `700 ${tagFontSize}px Inter, sans-serif`;
      const tagText = 'SCAN BOX';
      const tw = ctx.measureText(tagText).width + 12;
      const th = tagFontSize + 6;
      ctx.fillStyle = '#0891B2';
      ctx.beginPath();
      ctx.roundRect(bx + 6, by + 6, tw, th, 4);
      ctx.fill();
      ctx.fillStyle = '#FFFFFF';
      ctx.textBaseline = 'middle';
      ctx.fillText(tagText, bx + 12, by + 6 + th / 2);
      ctx.restore();

      // Draw detected ROI rings & labels
      state.computed.forEach(item => {
        const cx = item.nx * W;
        const cy = item.ny * H;
        const r = Math.max(8, item.nr * W);

        let ringColor = '#64748B';
        if (item.role === 'white') ringColor = '#FFFFFF';
        else if (item.role === 'control') ringColor = '#8B5CF6';
        else if (item.role === 'nontarget') ringColor = '#F59E0B';
        else if (item.call === 'POSITIVE') ringColor = '#10B981';

        ctx.save();
        ctx.beginPath();
        ctx.arc(cx, cy, r + lw, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(15, 23, 42, 0.85)';
        ctx.lineWidth = lw * 1.4;
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, Math.PI * 2);
        ctx.strokeStyle = ringColor;
        ctx.lineWidth = lw * 1.2;
        if (item.role === 'white') ctx.setLineDash([3, 3]);
        ctx.stroke();
        ctx.setLineDash([]);

        // Label pill above circle
        const fontSize = Math.max(11, Math.round(W * 0.017));
        ctx.font = `700 ${fontSize}px Inter, sans-serif`;
        const labelW = ctx.measureText(item.label).width + 10;
        const labelH = fontSize + 6;
        const lx = cx - labelW / 2;
        const ly = cy - r - labelH - 5;

        ctx.fillStyle = 'rgba(15, 23, 42, 0.88)';
        ctx.beginPath();
        ctx.roundRect(lx, ly, labelW, labelH, 4);
        ctx.fill();

        ctx.fillStyle = '#FFFFFF';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(item.label, cx, ly + labelH / 2);
        ctx.restore();
      });
    }

    function getCanvasNormPos(e) {
      const rect = imageCanvas.getBoundingClientRect();
      return {
        nx: Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width)),
        ny: Math.min(1, Math.max(0, (e.clientY - rect.top) / rect.height))
      };
    }

    imageCanvas.addEventListener('pointerdown', (e) => {
      if (!state.image) return;
      const pos = getCanvasNormPos(e);

      if (state.manualAddMode) {
        const hasCtrl = state.rois.some(r => r.role === 'control');
        const sampleNum = state.rois.filter(r => r.role !== 'white').length + 1;
        state.rois.push({
          id: nextRoiId++,
          label: hasCtrl ? `S${sampleNum}` : 'Water (C)',
          note: '',
          role: hasCtrl ? 'sample' : 'control',
          nx: pos.nx,
          ny: pos.ny,
          nr: 0.015
        });
        toggleManualAddMode();
        recalculateAndRender();
        return;
      }

      for (let i = state.rois.length - 1; i >= 0; i--) {
        const roi = state.rois[i];
        if (Math.hypot(pos.nx - roi.nx, pos.ny - roi.ny) <= Math.max(0.025, roi.nr * 1.4)) {
          state.dragAction = { type: 'roi', id: roi.id };
          imageCanvas.setPointerCapture(e.pointerId);
          return;
        }
      }

      const edgeTol = 0.03;
      const inYRange = pos.ny >= state.boxTop - edgeTol && pos.ny <= state.boxBottom + edgeTol;
      const inXRange = pos.nx >= state.boxLeft - edgeTol && pos.nx <= state.boxRight + edgeTol;

      if (inXRange && Math.abs(pos.ny - state.boxTop) <= edgeTol) {
        state.dragAction = { type: 'box-top' };
      } else if (inXRange && Math.abs(pos.ny - state.boxBottom) <= edgeTol) {
        state.dragAction = { type: 'box-bottom' };
      } else if (inYRange && Math.abs(pos.nx - state.boxLeft) <= edgeTol) {
        state.dragAction = { type: 'box-left' };
      } else if (inYRange && Math.abs(pos.nx - state.boxRight) <= edgeTol) {
        state.dragAction = { type: 'box-right' };
      } else if (
        pos.nx > state.boxLeft && pos.nx < state.boxRight &&
        pos.ny > state.boxTop && pos.ny < state.boxBottom
      ) {
        state.dragAction = {
          type: 'box-move',
          startNx: pos.nx,
          startNy: pos.ny,
          origLeft: state.boxLeft,
          origRight: state.boxRight,
          origTop: state.boxTop,
          origBottom: state.boxBottom
        };
      }

      if (state.dragAction) {
        imageCanvas.setPointerCapture(e.pointerId);
      }
    });

    imageCanvas.addEventListener('pointermove', (e) => {
      if (!state.image || !state.dragAction) return;
      const pos = getCanvasNormPos(e);
      const act = state.dragAction;

      if (act.type === 'roi') {
        const roi = state.rois.find(r => r.id === act.id);
        if (roi) {
          roi.nx = pos.nx;
          roi.ny = pos.ny;
          recalculateAndRender();
        }
        return;
      }

      const minSpan = 0.08;
      if (act.type === 'box-top') {
        state.boxTop = Math.min(state.boxBottom - minSpan, Math.max(0.02, pos.ny));
      } else if (act.type === 'box-bottom') {
        state.boxBottom = Math.max(state.boxTop + minSpan, Math.min(0.98, pos.ny));
      } else if (act.type === 'box-left') {
        state.boxLeft = Math.min(state.boxRight - minSpan, Math.max(0.02, pos.nx));
      } else if (act.type === 'box-right') {
        state.boxRight = Math.max(state.boxLeft + minSpan, Math.min(0.98, pos.nx));
      } else if (act.type === 'box-move') {
        const dx = pos.nx - act.startNx;
        const dy = pos.ny - act.startNy;
        const wSpan = act.origRight - act.origLeft;
        const hSpan = act.origBottom - act.origTop;
        let newL = Math.min(0.98 - wSpan, Math.max(0.02, act.origLeft + dx));
        let newT = Math.min(0.98 - hSpan, Math.max(0.02, act.origTop + dy));
        state.boxLeft = newL;
        state.boxRight = newL + wSpan;
        state.boxTop = newT;
        state.boxBottom = newT + hSpan;
      }

      updateBoxLabel();
      drawCanvas();
    });

    imageCanvas.addEventListener('pointerup', (e) => {
      if (!state.dragAction) return;
      const wasBox = state.dragAction.type.startsWith('box');
      state.dragAction = null;
      try { imageCanvas.releasePointerCapture(e.pointerId); } catch (_) {}
      if (wasBox) {
        runAutoDetection();
      }
    });

    // =========================================================================
    // BATCH SESSION LOG & 22-COLUMN CSV EXPORT (WITH PER-TUBE NOTES)
    // =========================================================================
    function saveCurrentPhotoToSession() {
      const tubes = state.computed.filter(r => r.role !== 'white');
      if (tubes.length === 0) return;

      const batchNotes = document.getElementById('runNotesInput').value.trim() || state.fileName || 'Untitled Run';
      const timestamp = new Date().toISOString();

      tubes.forEach(t => {
        state.sessionLog.push({
          timestamp,
          fileName: state.fileName,
          notes: batchNotes,
          tubeLabel: t.label,
          tubeNote: (t.note || '').trim(),
          role: t.role,
          qcStatus: state.qcStatus,
          rawR: t.raw.r.toFixed(1),
          rawG: t.raw.g.toFixed(1),
          rawB: t.raw.b.toFixed(1),
          wbR: t.wb.r.toFixed(1),
          wbG: t.wb.g.toFixed(1),
          wbB: t.wb.b.toFixed(1),
          L_star: t.lab.L.toFixed(2),
          a_star: t.lab.a.toFixed(2),
          b_star: t.lab.b.toFixed(2),
          deltaA: t.deltaA.toFixed(2),
          deltaE: t.deltaE.toFixed(2),
          absRatio: t.absRatio.toFixed(3),
          relAbs: t.relAbs.toFixed(3),
          relLegacyRB: t.relLegacyRB.toFixed(3),
          ratioVsMaxNT: t.ratioVsMaxNT != null ? t.ratioVsMaxNT.toFixed(3) : '',
          call: t.call
        });
      });

      persistSessionLog();
      renderSessionLog();
      showToast(`Saved ${tubes.length} tube${tubes.length === 1 ? '' : 's'} to Session Log.`, 'success');
    }

    function renderSessionLog() {
      const count = state.sessionLog.length;
      document.getElementById('sessionRowCount').textContent = count;
      document.getElementById('headerSessionCount').textContent = count;
      document.getElementById('clearSessionBtn').disabled = count === 0;
      document.getElementById('exportCsvBtn').disabled = count === 0;
      document.getElementById('headerExportBtn').disabled = count === 0;

      const tbody = document.getElementById('sessionLogBody');
      if (count === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="py-5 text-center text-slate-400">Session log is empty. Click "Save Run" to record a photo.</td></tr>`;
        return;
      }

      tbody.innerHTML = state.sessionLog.slice().reverse().map(row => `
        <tr class="hover:bg-slate-50">
          <td class="py-1.5 px-2.5 font-medium text-slate-700 truncate max-w-[130px]" title="${escapeHtml(row.notes)}">${escapeHtml(row.notes)}</td>
          <td class="py-1.5 px-2 font-semibold text-navy-900">${escapeHtml(row.tubeLabel)}</td>
          <td class="py-1.5 px-2 text-slate-600 truncate max-w-[110px]" title="${escapeHtml(row.tubeNote || '')}">${escapeHtml(row.tubeNote || '—')}</td>
          <td class="py-1.5 px-2 text-slate-500 capitalize">${escapeHtml(row.role)}</td>
          <td class="py-1.5 px-2 text-right font-mono font-semibold text-navy-900">${row.relAbs}</td>
          <td class="py-1.5 px-2 text-center">
            <span class="inline-block text-[9px] font-mono font-bold px-2 py-0.5 rounded-full ${getCallBadgeClass(row.call)}">${row.call}</span>
          </td>
        </tr>
      `).join('');
    }

    function clearSessionLog() {
      if (state.sessionLog.length === 0) return;
      state.sessionLog = [];
      persistSessionLog();
      renderSessionLog();
      showToast('Session log cleared.', 'info');
    }

    function exportSessionCSV() {
      if (state.sessionLog.length === 0) return;

      const headers = [
        'Timestamp', 'File_Name', 'Batch_Notes', 'Tube_Label', 'Tube_Note', 'Role', 'QC_Status',
        'Raw_R', 'Raw_G', 'Raw_B', 'WB_R', 'WB_G', 'WB_B',
        'CIE_L', 'CIE_a', 'CIE_b', 'Delta_a', 'Delta_E',
        'PseudoAbs_AG_AR', 'Rel_AG_AR', 'Rel_Legacy_RB', 'Ratio_vs_Max_NT', 'Call'
      ];

      const csvRows = [headers.join(',')];
      state.sessionLog.forEach(r => {
        const vals = [
          r.timestamp, r.fileName, r.notes, r.tubeLabel, r.tubeNote || '', r.role, r.qcStatus,
          r.rawR, r.rawG, r.rawB, r.wbR, r.wbG, r.wbB,
          r.L_star, r.a_star, r.b_star, r.deltaA, r.deltaE,
          r.absRatio, r.relAbs, r.relLegacyRB, r.ratioVsMaxNT, r.call
        ].map(v => `"${String(v ?? '').replace(/"/g, '""')}"`);
        csvRows.push(vals.join(','));
      });

      const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `BoodooScan_Session_${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Exported 22-column Session CSV.', 'success');
    }

    // =========================================================================
    // HELPERS & INITIALIZATION
    // =========================================================================
    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function showToast(msg, type = 'info') {
      const container = document.getElementById('toastContainer');
      const el = document.createElement('div');
      const colors = {
        success: 'bg-emerald-900 text-white border-emerald-700',
        error: 'bg-rose-900 text-white border-rose-700',
        info: 'bg-navy-900 text-white border-slate-700'
      };
      el.className = `px-3.5 py-2.5 rounded-xl border shadow-lg text-xs font-medium transition-opacity duration-300 max-w-sm ${colors[type] || colors.info}`;
      el.textContent = msg;
      container.appendChild(el);
      setTimeout(() => {
        el.style.opacity = '0';
        setTimeout(() => el.remove(), 300);
      }, 3600);
    }

    // Initialize on load
    loadSavedSession();
    updateBoxLabel();
  </script>
</body>
</html>
