  <footer class="text-center py-3 text-xs text-slate-400 border-t border-slate-200 bg-white mt-4">
    BoodooScan Auto • Client-Side 4-Sided Scan-Box &amp; White-Rack Colorimetry • Runs 100% locally in your browser
  </footer>

  <!-- Hidden Offscreen Canvases -->
  <canvas id="offscreenCanvas" class="hidden"></canvas>
  <canvas id="cvCanvas" class="hidden"></canvas>

  <script>
    // =========================================================================
    // APPLICATION STATE & DOM REFERENCES
    // =========================================================================
    const STORAGE_KEY = 'boodooscan_auto_session_v1';
    const DEFAULT_BOX = { left: 0.08, right: 0.92, top: 0.28, bottom: 0.52 };

    const state = {
      image: null,
      fileName: '',
      rois: [],
      computed: [],
      sessionLog: [],
      boxLeft: DEFAULT_BOX.left,
      boxRight: DEFAULT_BOX.right,
      boxTop: DEFAULT_BOX.top,
      boxBottom: DEFAULT_BOX.bottom,
      sensitivity: 0.12,
      useWhiteBalance: true,
      ntCalibrate: false,
      researchMode: false,
      settingsOpen: false,
      cutoffDeltaA: 10.0,
      cutoffRelAbs: 1.30,
      ntMarginDeltaA: 5.0,
      ntMarginMult: 1.25,
      qcStatus: 'PENDING',
      manualAddMode: false,
      dragAction: null
    };

    let nextRoiId = 1;
    let dragCounter = 0;

    const fileInput = document.getElementById('fileInput');
    const cameraInput = document.getElementById('cameraInput');
    const canvasWrapper = document.getElementById('canvasWrapper');
    const canvasDragOverlay = document.getElementById('canvasDragOverlay');
    const imageCanvas = document.getElementById('imageCanvas');
    const ctx = imageCanvas.getContext('2d');
    const offscreenCanvas = document.getElementById('offscreenCanvas');
    const offCtx = offscreenCanvas.getContext('2d', { willReadFrequently: true });
    const cvCanvas = document.getElementById('cvCanvas');
    const cvCtx = cvCanvas.getContext('2d', { willReadFrequently: true });

    // =========================================================================
    // GUIDE MODAL & LOCALSTORAGE PERSISTENCE
    // =========================================================================
    function openGuideModal(tab = 'how') {
      document.getElementById('guideModal').classList.remove('hidden');
      switchGuideTab(tab);
    }

    function closeGuideModal() {
      document.getElementById('guideModal').classList.add('hidden');
    }

    function closeGuideOnBackdrop(e) {
      if (e.target && e.target.id === 'guideModal') {
        closeGuideModal();
      }
    }

    function switchGuideTab(tab) {
      const tabs = ['how', 'metrics', 'tips'];
      tabs.forEach(t => {
        const panel = document.getElementById('guideTab' + t.charAt(0).toUpperCase() + t.slice(1));
        const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
        if (!panel || !btn) return;
        const active = (t === tab);
        panel.classList.toggle('hidden', !active);
        btn.className = active
          ? 'px-3.5 py-2 text-xs font-semibold rounded-t-lg border-b-2 border-teal-600 text-teal-700 bg-white'
          : 'px-3.5 py-2 text-xs font-semibold rounded-t-lg border-b-2 border-transparent text-slate-500 hover:text-slate-800';
      });
    }

    function loadSavedSession() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) {
            state.sessionLog = parsed;
          }
        }
      } catch (_) {}
      renderSessionLog();
    }

    function persistSessionLog() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state.sessionLog));
      } catch (_) {}
    }

    // =========================================================================
    // EVENT LISTENERS: UPLOAD, CAMERA, PASTE & DRAG-AND-DROP
    // =========================================================================
    [fileInput, cameraInput].forEach(inputEl => {
      inputEl.addEventListener('change', (e) => {
        if (e.target.files && e.target.files[0]) {
          loadImageFile(e.target.files[0]);
          e.target.value = '';
        }
      });
    });

    window.addEventListener('paste', (e) => {
      const clipboard = e.clipboardData || window.clipboardData;
      if (!clipboard || !clipboard.items) return;

      for (let i = 0; i < clipboard.items.length; i++) {
        const item = clipboard.items[i];
        if (item.type && item.type.startsWith('image/')) {
          e.preventDefault();
          const blob = item.getAsFile();
          if (blob) {
            const ext = (item.type.split('/')[1] || 'png').replace('jpeg', 'jpg');
            const stamp = new Date().toISOString().slice(11, 19).replace(/:/g, '');
            const namedFile = new File([blob], `pasted_photo_${stamp}.${ext}`, { type: item.type });
            loadImageFile(namedFile);
            showToast('Pasted image loaded from clipboard!', 'success');
          }
          return;
        }
      }
    });

    window.addEventListener('dragover', (e) => {
      if (e.dataTransfer && Array.from(e.dataTransfer.types || []).includes('Files')) {
        e.preventDefault();
      }
    });

    window.addEventListener('drop', (e) => {
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        e.preventDefault();
        dragCounter = 0;
        canvasDragOverlay.classList.add('hidden');
        loadImageFile(e.dataTransfer.files[0]);
      }
    });

    canvasWrapper.addEventListener('dragenter', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dragCounter++;
      canvasDragOverlay.classList.remove('hidden');
    });

    canvasWrapper.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.stopPropagation();
    });

    canvasWrapper.addEventListener('dragleave', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dragCounter = Math.max(0, dragCounter - 1);
      if (dragCounter === 0) {
        canvasDragOverlay.classList.add('hidden');
      }
    });

    canvasWrapper.addEventListener('drop', (e) => {
      e.preventDefault();
      e.stopPropagation();
      dragCounter = 0;
      canvasDragOverlay.classList.add('hidden');
      if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]) {
        loadImageFile(e.dataTransfer.files[0]);
      }
    });

    document.getElementById('sensitivitySlider').addEventListener('input', (e) => {
      state.sensitivity = parseFloat(e.target.value);
      document.getElementById('sensitivityVal').textContent = state.sensitivity.toFixed(2);
    });

    document.getElementById('sensitivitySlider').addEventListener('change', () => {
      if (state.image) runAutoDetection();
    });

    document.getElementById('wbToggle').addEventListener('change', (e) => {
      state.useWhiteBalance = e.target.checked;
      recalculateAndRender();
    });

    document.getElementById('ntCalibrateToggle').addEventListener('change', (e) => {
      state.ntCalibrate = e.target.checked;
      recalculateAndRender();
    });

    document.getElementById('researchModeToggle').addEventListener('change', (e) => {
      state.researchMode = e.target.checked;
      recalculateAndRender();
    });

    ['cutoffDeltaA', 'cutoffRelAbs', 'ntMarginDeltaA', 'ntMarginMult'].forEach(id => {
      document.getElementById(id).addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        if (!isNaN(val)) {
          state[id] = val;
          recalculateAndRender();
        }
      });
    });

    function toggleCalibrationSettings() {
      state.settingsOpen = !state.settingsOpen;
      document.getElementById('calibrationBody').classList.toggle('hidden', !state.settingsOpen);
      document.getElementById('calibrationChevron').classList.toggle('rotate-180', state.settingsOpen);
    }

    function resetScanBox() {
      state.boxLeft = DEFAULT_BOX.left;
      state.boxRight = DEFAULT_BOX.right;
      state.boxTop = DEFAULT_BOX.top;
      state.boxBottom = DEFAULT_BOX.bottom;
      updateBoxLabel();
      if (state.image) {
        runAutoDetection();
        showToast('Scan Box reset to default framing.', 'info');
      }
    }

    function clearCurrentPhoto() {
      state.image = null;
      state.fileName = '';
      state.rois = [];
      state.computed = [];
      state.qcStatus = 'PENDING';
      state.manualAddMode = false;
      state.dragAction = null;

      ctx.clearRect(0, 0, imageCanvas.width, imageCanvas.height);
      imageCanvas.classList.add('hidden');
      imageCanvas.style.cursor = 'default';
      document.getElementById('emptyCanvasPrompt').classList.remove('hidden');

      document.getElementById('currentFileName').textContent = 'No file';
      document.getElementById('detectionSummaryBadge').textContent = '0 tubes';
      document.getElementById('currentRoiCount').textContent = '0 tubes';
      document.getElementById('redetectBtn').disabled = true;
      document.getElementById('manualAddBtn').disabled = true;
      document.getElementById('resetBoxBtn').disabled = true;
      document.getElementById('clearPhotoBtn').disabled = true;
      document.getElementById('headerSaveBtn').disabled = true;
      document.getElementById('ntSummaryPill').classList.add('hidden');

      const manualBtn = document.getElementById('manualAddBtn');
      manualBtn.className = 'px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-300 bg-white text-slate-700 hover:bg-slate-100 disabled:opacity-40 transition';
      manualBtn.textContent = '+ Manual Tube';

      const banner = document.getElementById('qcBanner');
      const icon = document.getElementById('qcIcon');
      const title = document.getElementById('qcTitle');
      const subtitle = document.getElementById('qcSubtitle');
      const badge = document.getElementById('qcBadge');
      banner.className = 'rounded-xl border border-slate-200 bg-white px-4 py-3 shadow-sm flex items-center justify-between gap-3 transition-colors';
      icon.className = 'w-9 h-9 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center shrink-0';
      title.textContent = 'Water-Control QC Gate: Waiting for Photo';
      subtitle.textContent = 'Checks that the Water Control (C) aggregated to purple/blue/gray rather than staying red before trusting sample calls.';
      badge.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600 shrink-0';
      badge.textContent = 'PENDING';

      renderResultsTable();
      showToast('Photo cleared. Ready to drop, upload, or paste a new image.', 'info');
    }

    function updateBoxLabel() {
      const l = Math.round(state.boxLeft * 100);
      const r = Math.round(state.boxRight * 100);
      const t = Math.round(state.boxTop * 100);
      const b = Math.round(state.boxBottom * 100);
      document.getElementById('boxRangeLabel').textContent = `Box: X ${l}%–${r}% | Y ${t}%–${b}%`;
    }

    // =========================================================================
    // IMAGE LOADING & AUTO-DETECTION PIPELINE (LIQUID-TIP WEIGHTED CENTROID)
    // =========================================================================
    function loadImageFile(file) {
      if (!file.type.startsWith('image/')) {
        showToast('Please select a valid image file.', 'error');
        return;
      }

      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          state.image = img;
          state.fileName = file.name || 'tube_photo.png';
          state.manualAddMode = false;

          offscreenCanvas.width = img.naturalWidth;
          offscreenCanvas.height = img.naturalHeight;
          offCtx.drawImage(img, 0, 0);

          document.getElementById('emptyCanvasPrompt').classList.add('hidden');
          imageCanvas.classList.remove('hidden');
          document.getElementById('currentFileName').textContent = state.fileName;
          document.getElementById('redetectBtn').disabled = false;
          document.getElementById('manualAddBtn').disabled = false;
          document.getElementById('resetBoxBtn').disabled = false;
          document.getElementById('clearPhotoBtn').disabled = false;

          runAutoDetection();
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

    function rgbToHsv(r, g, b) {
      const rn = r / 255, gn = g / 255, bn = b / 255;
      const max = Math.max(rn, gn, bn), min = Math.min(rn, gn, bn);
      const d = max - min;
      let h = 0;
      if (d !== 0) {
        if (max === rn) h = ((gn - bn) / d) % 6;
        else if (max === gn) h = (bn - rn) / d + 2;
        else h = (rn - gn) / d + 4;
        h *= 60;
        if (h < 0) h += 360;
      }
      const s = max === 0 ? 0 : d / max;
      return { h, s, v: max };
    }

    function runAutoDetection() {
      if (!state.image) return;

      const origW = state.image.naturalWidth;
      const origH = state.image.naturalHeight;
      const targetW = 420;
      const scale = targetW / origW;
      const w = Math.max(80, Math.round(origW * scale));
      const h = Math.max(60, Math.round(origH * scale));

      cvCanvas.width = w;
      cvCanvas.height = h;
      cvCtx.drawImage(state.image, 0, 0, w, h);
      const imgData = cvCtx.getImageData(0, 0, w, h).data;

      const x0 = Math.max(2, Math.floor(w * state.boxLeft));
      const x1 = Math.min(w - 3, Math.ceil(w * state.boxRight));
      const y0 = Math.max(2, Math.floor(h * state.boxTop));
      const y1 = Math.min(h - 3, Math.ceil(h * state.boxBottom));

      const lum = new Float32Array(w * h);
      const sat = new Float32Array(w * h);
      const hue = new Float32Array(w * h);

      for (let i = 0; i < w * h; i++) {
        const r = imgData[i * 4];
        const g = imgData[i * 4 + 1];
        const b = imgData[i * 4 + 2];
        lum[i] = 0.2126 * r + 0.7152 * g + 0.0722 * b;
        const hsv = rgbToHsv(r, g, b);
        sat[i] = hsv.s;
        hue[i] = hsv.h;
      }

      // Dual-mode mask: chromatic red/purple liquid OR pale aggregated gray liquid flanked by bright white rack
      const mask = new Uint8Array(w * h);
      const chromFlag = new Uint8Array(w * h);
      const satThresh = state.sensitivity;

      for (let y = y0; y <= y1; y++) {
        for (let x = x0; x <= x1; x++) {
          const idx = y * w + x;
          const L = lum[idx];
          const S = sat[idx];
          const H = hue[idx];

          const isYellowTape = (H >= 38 && H <= 78 && S > 0.24);
          if (isYellowTape || L < 35 || L > 245) continue;

          const isRedOrPurpleHue = (H >= 215 || H <= 22);
          const isChromatic = isRedOrPurpleHue && S >= satThresh && L >= 45 && L <= 225;

          let isPaleDip = false;
          if (!isChromatic && S < 0.24 && L >= 75 && L <= 215) {
            const leftX = x - 15;
            const rightX = x + 15;
            if (leftX >= x0 && rightX <= x1) {
              const idxL = y * w + leftX;
              const idxR = y * w + rightX;
              const flankL = lum[idxL];
              const flankR = lum[idxR];
              if (
                sat[idxL] < 0.20 && sat[idxR] < 0.20 &&
                flankL > 140 && flankR > 140 &&
                (flankL - L) >= 16 && (flankR - L) >= 16
              ) {
                isPaleDip = true;
              }
            }
          }

          if (isChromatic || isPaleDip) {
            mask[idx] = 1;
            if (isChromatic) chromFlag[idx] = 1;
          }
        }
      }

      // Connected components with liquid-tip weighted centroid (prevents empty upper tube barrel from pulling circle upward)
      const visited = new Uint8Array(w * h);
      const rawBlobs = [];
      const minArea = Math.max(10, Math.round(w * h * 0.00018));
      const maxArea = Math.round(w * h * 0.015);

      for (let y = y0; y <= y1; y++) {
        for (let x = x0; x <= x1; x++) {
          const startIdx = y * w + x;
          if (!mask[startIdx] || visited[startIdx]) continue;

          const queue = [startIdx];
          visited[startIdx] = 1;
          let count = 0;
          let minBX = x, maxBX = x, minBY = y, maxBY = y;

          let head = 0;
          while (head < queue.length) {
            const curr = queue[head++];
            const cx = curr % w;
            const cy = (curr - cx) / w;
            count++;
            if (cx < minBX) minBX = cx;
            if (cx > maxBX) maxBX = cx;
            if (cy < minBY) minBY = cy;
            if (cy > maxBY) maxBY = cy;

            const neighbors = [curr - 1, curr + 1, curr - w, curr + w];
            for (let n = 0; n < 4; n++) {
              const nIdx = neighbors[n];
              if (nIdx >= 0 && nIdx < w * h && !visited[nIdx] && mask[nIdx]) {
                const nx = nIdx % w;
                const ny = (nIdx - nx) / w;
                if (nx >= x0 && nx <= x1 && ny >= y0 && ny <= y1) {
                  visited[nIdx] = 1;
                  queue.push(nIdx);
                }
              }
            }
          }

          const bw = maxBX - minBX + 1;
          const bh = maxBY - minBY + 1;
          const aspect = bw / Math.max(1, bh);

          if (count >= minArea && count <= maxArea && aspect >= 0.30 && aspect <= 2.4) {
            // Focus on the liquid tip (bottom 60% of the blob or chromatic core) so upper tube barrel shadows don't shift Y upward
            const cutY = minBY + bh * 0.40;
            let wSumX = 0, wSumY = 0, wTotal = 0;
            let tipCount = 0;

            for (let k = 0; k < queue.length; k++) {
              const pIdx = queue[k];
              const px = pIdx % w;
              const py = (pIdx - px) / w;
              if (py < cutY && bh > 8) continue;

              const weight = (chromFlag[pIdx] ? (1 + sat[pIdx] * 6) : 1.0) * (1 + (py - minBY) / Math.max(1, bh));
              wSumX += px * weight;
              wSumY += py * weight;
              wTotal += weight;
              tipCount++;
            }

            if (wTotal === 0) {
              for (let k = 0; k < queue.length; k++) {
                const pIdx = queue[k];
                wSumX += (pIdx % w);
                wSumY += Math.floor(pIdx / w);
                wTotal += 1;
              }
              tipCount = queue.length;
            }

            const centX = wSumX / wTotal;
            const centY = wSumY / wTotal;

            const fDist = Math.max(12, Math.round(bw * 1.4));
            const lx = Math.max(x0, Math.round(centX - fDist));
            const rx = Math.min(x1, Math.round(centX + fDist));
            const cyInt = Math.round(centY);
            const lIdx = cyInt * w + lx;
            const rIdx = cyInt * w + rx;
            const hasWhiteFlank =
              (lum[lIdx] > 130 && sat[lIdx] < 0.25) ||
              (lum[rIdx] > 130 && sat[rIdx] < 0.25);

            if (hasWhiteFlank) {
              rawBlobs.push({
                nx: centX / w,
                ny: centY / h,
                nr: Math.min(0.025, Math.max(0.012, (Math.sqrt(tipCount / Math.PI) * 0.80) / w)),
                area: count
              });
            }
          }
        }
      }

      rawBlobs.sort((a, b) => a.nx - b.nx);
      const merged = [];
      for (const blob of rawBlobs) {
        const prev = merged[merged.length - 1];
        if (prev && Math.abs(blob.nx - prev.nx) < 0.065 && Math.abs(blob.ny - prev.ny) < 0.08) {
          if (blob.area > prev.area) {
            merged[merged.length - 1] = blob;
          }
        } else {
          merged.push(blob);
        }
      }

      let rowTubes = merged;
      if (merged.length >= 2) {
        const ys = merged.map(b => b.ny).sort((a, b) => a - b);
        const medY = ys[Math.floor(ys.length / 2)];
        const inRow = merged.filter(b => Math.abs(b.ny - medY) <= 0.065);
        if (inRow.length >= 1) {
          rowTubes = inRow;
        }
      }

      // Row-guided recovery for ultra-pale aggregated tubes along the detected liquid Y row
      if (rowTubes.length >= 1) {
        const avgY = rowTubes.reduce((acc, b) => acc + b.ny, 0) / rowTubes.length;
        const scanY = Math.round(avgY * h);
        if (scanY >= y0 + 2 && scanY <= y1 - 2) {
          for (let sx = x0 + 16; sx <= x1 - 16; sx += 3) {
            const nxCand = sx / w;
            if (rowTubes.some(t => Math.abs(t.nx - nxCand) < 0.075)) continue;

            const cIdx = scanY * w + sx;
            const lIdx = scanY * w + (sx - 15);
            const rIdx = scanY * w + (sx + 15);
            const cLum = lum[cIdx];
            const lLum = lum[lIdx];
            const rLum = lum[rIdx];

            if (
              sat[cIdx] < 0.22 && cLum >= 85 && cLum <= 215 &&
              sat[lIdx] < 0.18 && sat[rIdx] < 0.18 &&
              lLum > 145 && rLum > 145 &&
              (lLum - cLum) >= 14 && (rLum - cLum) >= 14
            ) {
              rowTubes.push({
                nx: nxCand,
                ny: avgY,
                nr: 0.015,
                area: 20
              });
            }
          }
          rowTubes.sort((a, b) => a.nx - b.nx);
        }
      }

      const newRois = [];
      rowTubes.forEach((t, i) => {
        newRois.push({
          id: nextRoiId++,
          label: i === 0 ? 'Water (C)' : `S${i}`,
          note: '',
          role: i === 0 ? 'control' : 'sample',
          nx: t.nx,
          ny: t.ny,
          nr: t.nr
        });
      });

      const whiteRef = findCleanWhitePatch(w, h, x0, x1, y0, y1, lum, sat, rowTubes);
      if (whiteRef) {
        newRois.push({
          id: nextRoiId++,
          label: 'W',
          note: '',
          role: 'white',
          nx: whiteRef.nx,
          ny: whiteRef.ny,
          nr: 0.015
        });
      }

      state.rois = newRois;
      recalculateAndRender();
    }

    function findCleanWhitePatch(w, h, x0, x1, y0, y1, lum, sat, tubes) {
      let bestScore = -Infinity;
      let bestX = null;
      let bestY = null;

      const padX = Math.max(8, Math.round((x1 - x0) * 0.05));
      const padY = Math.max(6, Math.round((y1 - y0) * 0.10));

      for (let y = y0 + padY; y <= y1 - padY; y += 4) {
        for (let x = x0 + padX; x <= x1 - padX; x += 6) {
          const nx = x / w;
          const ny = y / h;
          if (tubes.some(t => Math.hypot(t.nx - nx, t.ny - ny) < 0.065)) continue;

          const idx = y * w + x;
          const L = lum[idx];
          const S = sat[idx];
          if (L < 165 || S > 0.14) continue;

          let minN = 255, maxN = 0;
          for (let dy = -2; dy <= 2; dy += 2) {
            for (let dx = -2; dx <= 2; dx += 2) {
              const v = lum[(y + dy) * w + (x + dx)];
              if (v < minN) minN = v;
              if (v > maxN) maxN = v;
            }
          }
          const uniformity = 255 - (maxN - minN);
          const score = L + uniformity * 0.8 - S * 400;
          if (score > bestScore) {
            bestScore = score;
            bestX = nx;
            bestY = ny;
          }
        }
      }

      return bestX !== null ? { nx: bestX, ny: bestY } : null;
    }

    // =========================================================================
    // GLARE-REJECTED SAMPLING & COLORIMETRIC MATH (CIE L*a*b* + BEER-LAMBERT)
    // =========================================================================
    function sampleTubePixels(roi) {
      const W = offscreenCanvas.width;
      const H = offscreenCanvas.height;
      const cx = Math.round(roi.nx * W);
      const cy = Math.round(roi.ny * H);
      const rPx = Math.max(4, Math.round(roi.nr * W));

      const xStart = Math.max(0, cx - rPx);
      const yStart = Math.max(0, cy - rPx);
      const xEnd = Math.min(W - 1, cx + rPx);
      const yEnd = Math.min(H - 1, cy + rPx);
      const boxW = xEnd - xStart + 1;
      const boxH = yEnd - yStart + 1;

      if (boxW <= 0 || boxH <= 0) return { r: 128, g: 128, b: 128 };

      const data = offCtx.getImageData(xStart, yStart, boxW, boxH).data;
      const pixels = [];
      const rSq = rPx * rPx;

      for (let dy = 0; dy < boxH; dy++) {
        for (let dx = 0; dx < boxW; dx++) {
          const ox = xStart + dx - cx;
          const oy = yStart + dy - cy;
          if (ox * ox + oy * oy <= rSq) {
            const idx = (dy * boxW + dx) * 4;
            const r = data[idx];
            const g = data[idx + 1];
            const b = data[idx + 2];
            const luma = 0.2126 * r + 0.7152 * g + 0.0722 * b;
            pixels.push({ r, g, b, luma });
          }
        }
      }

      if (pixels.length === 0) return { r: 128, g: 128, b: 128 };

      pixels.sort((a, b) => a.luma - b.luma);
      const trim = Math.floor(pixels.length * 0.15);
      const kept = pixels.slice(trim, Math.max(trim + 1, pixels.length - trim));

      let sumR = 0, sumG = 0, sumB = 0;
      for (const p of kept) {
        sumR += p.r;
        sumG += p.g;
        sumB += p.b;
      }
      const n = kept.length;
      return { r: sumR / n, g: sumG / n, b: sumB / n };
    }

    function rgbToLab(r, g, b) {
      let rn = r / 255, gn = g / 255, bn = b / 255;
      rn = rn > 0.04045 ? Math.pow((rn + 0.055) / 1.055, 2.4) : rn / 12.92;
      gn = gn > 0.04045 ? Math.pow((gn + 0.055) / 1.055, 2.4) : gn / 12.92;
      bn = bn > 0.04045 ? Math.pow((bn + 0.055) / 1.055, 2.4) : bn / 12.92;

      let x = (rn * 0.4124564 + gn * 0.3575761 + bn * 0.1804375) / 0.95047;
      let y = (rn * 0.2126729 + gn * 0.7151522 + bn * 0.0721750) / 1.00000;
      let z = (rn * 0.0193339 + gn * 0.1191920 + bn * 0.9503041) / 1.08883;

      const f = (t) => (t > 0.008856 ? Math.cbrt(t) : (7.787 * t) + (16 / 116));
      const fx = f(x), fy = f(y), fz = f(z);

      return {
        L: 116 * fy - 16,
        a: 500 * (fx - fy),
        b: 200 * (fy - fz)
      };
    }

    // =========================================================================
    // RECALCULATE METRICS, QC GATE & RENDER TABLE + CANVAS
    // =========================================================================
    function recalculateAndRender() {
      if (!state.image) return;

      const hasNT = state.rois.some(r => r.role === 'nontarget');
      if (hasNT && !state.ntCalibrate) {
        state.ntCalibrate = true;
        document.getElementById('ntCalibrateToggle').checked = true;
      }

      const sampled = state.rois.map(roi => {
        const raw = sampleTubePixels(roi);
        return { ...roi, raw };
      });

      const whiteRoi = sampled.find(r => r.role === 'white');
      const refR = whiteRoi ? Math.max(40, whiteRoi.raw.r) : 235;
      const refG = whiteRoi ? Math.max(40, whiteRoi.raw.g) : 235;
      const refB = whiteRoi ? Math.max(40, whiteRoi.raw.b) : 235;

      const enriched = sampled.map(item => {
        let wbR = item.raw.r;
        let wbG = item.raw.g;
        let wbB = item.raw.b;

        if (state.useWhiteBalance && whiteRoi && item.role !== 'white') {
          wbR = Math.min(255, Math.max(1, (item.raw.r / refR) * 235));
          wbG = Math.min(255, Math.max(1, (item.raw.g / refG) * 235));
          wbB = Math.min(255, Math.max(1, (item.raw.b / refB) * 235));
        }

        const lab = rgbToLab(wbR, wbG, wbB);

        const normG = Math.min(0.99, Math.max(0.01, wbG / 245));
        const normR = Math.min(0.99, Math.max(0.01, wbR / 245));
        const absG = -Math.log10(normG);
        const absR = -Math.log10(normR);
        const absRatio = absG / Math.max(0.015, absR);
        const legacyRB = item.raw.r / Math.max(1, item.raw.b);

        return {
          ...item,
          wb: { r: wbR, g: wbG, b: wbB },
          lab,
          absRatio,
          legacyRB
        };
      });

      const controlItem = enriched.find(r => r.role === 'control');
      const ctrlAbsRatio = controlItem ? controlItem.absRatio : 1.0;
      const ctrlLegacyRB = controlItem ? controlItem.legacyRB : 1.0;

      // Water-Control QC Gate: purple/violet/gray controls PASS; unaggregated red/pink controls FAIL
      let qcStatus = 'NO_CONTROL';
      if (controlItem) {
        const cRB = controlItem.wb.r / Math.max(1, controlItem.wb.b);
        const stayedRed = (controlItem.lab.a > 24.0 && controlItem.lab.b > -6.0 && cRB > 1.20);
        qcStatus = stayedRed ? 'FAIL' : 'PASS';
      }
      state.qcStatus = qcStatus;

      const withRel = enriched.map(item => {
        if (item.role === 'white') {
          return {
            ...item,
            deltaA: 0,
            deltaE: 0,
            relAbs: 1.0,
            relLegacyRB: 1.0
          };
        }
        const deltaA = controlItem ? (item.lab.a - controlItem.lab.a) : 0;
        const deltaE = controlItem
          ? Math.sqrt(
              Math.pow(item.lab.L - controlItem.lab.L, 2) +
              Math.pow(item.lab.a - controlItem.lab.a, 2) +
              Math.pow(item.lab.b - controlItem.lab.b, 2)
            )
          : 0;
        const relAbs = controlItem ? (item.absRatio / Math.max(0.05, ctrlAbsRatio)) : item.absRatio;
        const relLegacyRB = controlItem ? (item.legacyRB / Math.max(0.05, ctrlLegacyRB)) : item.legacyRB;

        return {
          ...item,
          deltaA,
          deltaE,
          relAbs,
          relLegacyRB
        };
      });

      const ntItems = withRel.filter(r => r.role === 'nontarget');
      const maxNtRelAbs = ntItems.length > 0 ? Math.max(...ntItems.map(r => r.relAbs)) : null;
      const maxNtDeltaA = ntItems.length > 0 ? Math.max(...ntItems.map(r => r.deltaA)) : null;

      const ntPill = document.getElementById('ntSummaryPill');
      if (maxNtRelAbs !== null) {
        ntPill.classList.remove('hidden');
        document.getElementById('ntSummaryText').textContent = `Max NT: ${maxNtRelAbs.toFixed(2)}× (Δa* ${maxNtDeltaA >= 0 ? '+' : ''}${maxNtDeltaA.toFixed(1)})`;
      } else {
        ntPill.classList.add('hidden');
      }

      // Strict Binary Call per Tube (POSITIVE or NEGATIVE)
      state.computed = withRel.map(item => {
        const ratioVsMaxNT = (maxNtRelAbs !== null && item.role !== 'white')
          ? (item.relAbs / Math.max(0.05, maxNtRelAbs))
          : null;

        let call = '—';
        if (item.role === 'white') {
          call = 'WHITE REF';
        } else if (item.role === 'control') {
          call = qcStatus === 'FAIL' ? 'QC FAIL (RED)' : 'WATER';
        } else if (item.role === 'nontarget') {
          call = 'NON-TARGET';
        } else {
          if (qcStatus !== 'PASS') {
            call = 'INVALID';
          } else {
            let effCutoffDeltaA = state.cutoffDeltaA;
            let effCutoffRelAbs = state.cutoffRelAbs;

            if (state.ntCalibrate && maxNtRelAbs !== null) {
              effCutoffDeltaA = Math.max(effCutoffDeltaA, maxNtDeltaA + state.ntMarginDeltaA);
              effCutoffRelAbs = Math.max(effCutoffRelAbs, maxNtRelAbs * state.ntMarginMult);
            }

            const passDeltaA = item.deltaA >= effCutoffDeltaA;
            const passRelAbs = item.relAbs >= effCutoffRelAbs;

            call = (passDeltaA && passRelAbs) ? 'POSITIVE' : 'NEGATIVE';
          }
        }

        return { ...item, ratioVsMaxNT, call };
      });

      updateQCBanner(qcStatus, controlItem);
      renderResultsTable();
      drawCanvas();

      const tubeCount = state.rois.filter(r => r.role !== 'white').length;
      document.getElementById('detectionSummaryBadge').textContent = `${tubeCount} tube${tubeCount === 1 ? '' : 's'}`;
      document.getElementById('currentRoiCount').textContent = `${tubeCount} tube${tubeCount === 1 ? '' : 's'}`;
      document.getElementById('headerSaveBtn').disabled = tubeCount === 0;
    }

    function updateQCBanner(qcStatus, controlItem) {
      const banner = document.getElementById('qcBanner');
      const icon = document.getElementById('qcIcon');
      const title = document.getElementById('qcTitle');
      const subtitle = document.getElementById('qcSubtitle');
      const badge = document.getElementById('qcBadge');

      if (qcStatus === 'PASS') {
        banner.className = 'rounded-xl border border-emerald-200 bg-emerald-50/70 px-4 py-3 shadow-sm flex items-center justify-between gap-3 transition-colors';
        icon.className = 'w-9 h-9 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0';
        title.textContent = 'Water-Control QC Gate: PASS';
        subtitle.textContent = `Control "${controlItem.label}" properly aggregated (a* = ${controlItem.lab.a.toFixed(1)}, b* = ${controlItem.lab.b.toFixed(1)}). Sample calls are valid.`;
        badge.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-emerald-600 text-white shrink-0';
        badge.textContent = 'PASS';
      } else if (qcStatus === 'FAIL') {
        banner.className = 'rounded-xl border border-rose-300 bg-rose-50 px-4 py-3 shadow-sm flex items-center justify-between gap-3 transition-colors';
        icon.className = 'w-9 h-9 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0';
        title.textContent = 'Water-Control QC Gate: FAILED (Unaggregated Red Control)';
        subtitle.textContent = `Control "${controlItem.label}" stayed red (a* = ${controlItem.lab.a.toFixed(1)} > 24). Sample calls are marked INVALID until a purple/gray water control is used.`;
        badge.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-rose-600 text-white shrink-0';
        badge.textContent = 'FAIL';
      } else {
        banner.className = 'rounded-xl border border-amber-200 bg-amber-50/70 px-4 py-3 shadow-sm flex items-center justify-between gap-3 transition-colors';
        icon.className = 'w-9 h-9 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center shrink-0';
        title.textContent = 'Water-Control QC Gate: No Water Control Assigned';
        subtitle.textContent = 'Assign one tube Role to "Water Control (C)" in the table below to normalize sample signals.';
        badge.className = 'text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-amber-500 text-white shrink-0';
        badge.textContent = 'NO CTRL';
      }
    }

    function getCallBadgeClass(call) {
      switch (call) {
        case 'POSITIVE': return 'bg-emerald-100 text-emerald-800 border border-emerald-200';
        case 'NEGATIVE': return 'bg-slate-100 text-slate-700 border border-slate-200';
        case 'WATER': return 'bg-violet-100 text-violet-800 border border-violet-200';
        case 'NON-TARGET': return 'bg-amber-50 text-amber-800 border border-amber-200';
        case 'WHITE REF': return 'bg-slate-100 text-slate-600 border border-slate-200';
        default: return 'bg-rose-100 text-rose-800 border border-rose-200';
      }
    }

    function renderResultsTable() {
      const thead = document.getElementById('resultsTableHead');
      const tbody = document.getElementById('resultsTableBody');
      const showNTCol = state.computed.some(r => r.role === 'nontarget');
      const isResearch = state.researchMode;

      if (isResearch) {
        thead.innerHTML = `
          <tr class="bg-slate-50/80 border-b border-slate-200 text-[10px] font-semibold uppercase tracking-wider text-slate-500">
            <th class="py-2 px-3">Tube</th>
            <th class="py-2 px-2">Tube Note</th>
            <th class="py-2 px-2">Role</th>
            <th class="py-2 px-2 text-right"><span class="th-tip" title="CIE L*a*b* green-to-red axis. Negative/low = purple/blue; high (> 24) = red.">a*</span></th>
            <th class="py-2 px-2 text-right"><span class="th-tip" title="Redness shift vs. Water Control (a*_sample - a*_water). Positive targets are >= +10.0.">Δa*</span></th>
            <th class="py-2 px-2 text-right"><span class="th-tip" title="Total 3D Euclidean color distance from Water Control across L*, a*, and b*.">ΔE</span></th>
            <th class="py-2 px-2 text-right"><span class="th-tip" title="Relative Beer-Lambert pseudo-absorbance (A_G/A_R) normalized to Water Control (= 1.00).">Rel A_G/A_R</span></th>
            <th class="py-2 px-2 text-right"><span class="th-tip" title="Legacy linear raw Red/Blue ratio normalized to Water Control (= 1.00).">Legacy R/B</span></th>
